# 应用安全
SECRET_KEY=please-change-this-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# 数据库（默认使用 backend/app.db 的 SQLite）
# DATABASE_URL=sqlite:///./app.db

# 跨域来源，多个用英文逗号分隔
CORS_ORIGINS=*

# 可选：联系表单邮件通知（不配置时仅保存到数据库）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO_EMAIL=
