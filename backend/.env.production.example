SECRET_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# 允许访问 API 的前端来源（不要用 *）
CORS_ORIGINS=https://zorua716.github.io

# HTTPS 环境必须为 true
COOKIE_SECURE=true

# 生产数据目录（Docker 中对应挂载卷）
DATABASE_URL=sqlite:////data/app.db
UPLOAD_DIR=/data/uploads

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO_EMAIL=
